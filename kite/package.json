{
  "name": "kite-monad-payments",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"tsx watch server/index.ts\" \"vite --host 0.0.0.0 --port 4173\"",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run tests/account-derivation.test.ts tests/ai-schema.test.ts tests/api.test.ts tests/contact-crypto.test.ts tests/invoices.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@category-labs/mera": "0.2.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "express": "4.22.3",
    "lucide-react": "0.468.0",
    "qrcode": "1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "viem": "2.57.4",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.15.30",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "9.2.5",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vite": "6.4.4",
    "vitest": "4.1.11"
  }
}
