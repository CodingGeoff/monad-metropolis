# Public WebAuthn relying-party ID, not a secret. Set the final production domain before creating real passkeys.
VITE_MERA_RP_ID=

# Server-only integrations. Never prefix secrets with VITE_ and never commit .env.
PORT=4174
# Preferred same-origin RPC provider. The server uses this first, then configured backups and the public testnet RPC.
ALCHEMY_API_KEY=
# Optional additional Monad testnet RPC (tried after Alchemy and before the built-in public fallback).
MONAD_RPC_URL=
# Optional comma-separated backup URLs. HTTPS only in production; up to three are considered.
MONAD_RPC_FALLBACK_URLS=
# Final built-in fallback: https://testnet-rpc.monad.xyz

# Envio HyperIndex GraphQL endpoint, e.g. the hosted deployment URL ending in /graphql.
ENVIO_GRAPHQL_URL=

# Optional model keys. The AI keys remain on the server and are never sent to the browser.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k3
QWEN_API_KEY=
# Alibaba Model Studio base URL may need your workspace/region URL.
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://tokenhub-intl.tencentcloudmaas.com/v1
HUNYUAN_MODEL=hy4-preview
